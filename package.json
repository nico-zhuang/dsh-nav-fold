{
  "name": "dsh-nav-fold",
  "version": "0.4.13-preview.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSH sidebar folding, customizable shortcut-driven focus navigation and workspace tabs; macOS-only logo hiding adapted from stoner-byte/dsh-hide-brand (MIT)",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-shortcuts"] }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/schemastery": "~3.18.5" },
  "files": ["lib", "cordis.patch.yml", "THIRD_PARTY_NOTICES.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "devDependencies": { "@deepseek-ai/schemastery": "3.18.5", "jsdom": "27.4.0", "react": "18.3.1", "react-dom": "18.3.1" }
}
